# Configuración de Base de Datos - Sistema de Consultas
# Municipalidad de Vicente López
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como ".env"
# 2. Completar los valores con los datos reales de conexión
# 3. NO subir el archivo .env al repositorio (contiene credenciales)

# Driver ODBC para Informix (debe estar instalado en el sistema)
DB_DRIVER=IBM INFORMIX ODBC DRIVER (64-bit)

# Configuración del servidor de base de datos
DB_HOST=192.9.200.5
DB_SERVICE=1521
DB_DATABASE=recaudaciones
DB_SERVER=munivl_tcp
DB_PROTOCOL=onsoctcp

# Credenciales de acceso (COMPLETAR CON DATOS REALES)
DB_UID=tu_usuario_aqui
DB_PWD=tu_contraseña_aqui

# NOTAS DE SEGURIDAD:
# - Cambiar las credenciales por defecto
# - Usar usuarios con permisos mínimos necesarios
# - No compartir este archivo con credenciales reales
# - Rotar contraseñas periódicamente
